{
  // Отдельный от tsconfig.json конфиг: у основного rootDir жёстко "src"
  // (нужно для корректного outDir при `npm run build`), а tests/ лежит
  // рядом, не под src — включение tests/ в основной конфиг сломало бы
  // сборку ("File is not under rootDir"). Здесь только noEmit-тайпчек,
  // ничего не собирается.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "tests"]
}
