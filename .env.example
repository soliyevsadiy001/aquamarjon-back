# Порт — Railway сам подставит свой PORT в проде, локально дефолт 8080.
PORT=8080

# Список источников, которым разрешено дёргать API (через запятую).
# Для Telegram Mini App это домен, где отдаётся фронтенд (например,
# ваш GitHub Pages / Vercel / Railway static URL). Оставьте "*" только
# для локальной разработки — в проде обязательно сузьте до реального домена.
CORS_ORIGIN=*

# Куда пишется SQLite-файл. На Railway примонтируйте volume на /data,
# иначе БД будет пересоздаваться при каждом деплое.
DATABASE_PATH=./data/aquamarjon.sqlite3

# ⚠️ ОБЯЗАТЕЛЬНО сгенерируйте длинную случайную строку для продакшена,
# например: openssl rand -hex 32. Это подписывает JWT — если утечёт,
# кто угодно сможет выписать себе токен админа.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Первый admin-аккаунт создаётся один раз командой `npm run seed:admin`
# (см. src/seed-admin.ts) из переменных ниже — так пароль админа никогда
# не попадает в код/git, только в env продакшена.
ADMIN_SEED_LOGIN=admin
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME=Владелец
ADMIN_SEED_PHONE=+998900000000

# Секретный ключ Anthropic — используется ТОЛЬКО здесь, на бэкенде
# (см. предупреждение в lib/api.ts фронтенда про то, почему его нельзя
# класть в клиентский бандл). Взять на console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Токен Telegram-бота — тоже только на бэкенде (см. предупреждение в
# lib/api.ts про то, что раньше он был виден в devtools). Взять у @BotFather.
# ⚠️ С этой версии используется ещё и для проверки подписи Telegram initData
# в /notifications/* и /promos/validate (см. src/middleware/telegram.ts) —
# если оставить пустым, эта проверка молча отключается (см. предупреждение
# в консоли при старте). Обязательно задайте в проде.
TELEGRAM_BOT_TOKEN=
# Chat ID, куда падают заявки "Нет доступа" из ContactSupportScreen —
# обычно это ваш личный chat_id или id группы поддержки.
TELEGRAM_SUPPORT_CHAT_ID=
